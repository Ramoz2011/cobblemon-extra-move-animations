{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:flareblitz_targetsmoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/fire/cloudyfire_white"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 20,
        "max_particles": 24
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.6
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.35 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)",
        "surface_only": false,
        "direction": ["(v.particle_random_1 - 0.5) * 0.5", 1, "(v.particle_random_3 - 0.5) * 0.5"]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.7 + 0.4 * v.particle_random_2"
      },
      "minecraft:particle_initial_speed": "0.4 + 0.4 * v.particle_random_4",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 1.2,
        "linear_acceleration": [0, 1.3, 0]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.floor(v.particle_random_4 * 4) * 90"
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["(0.36 + 0.15 * v.particle_random_3) * (0.6 + 0.35 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)) * (0.6 + 0.9 * (v.particle_age / v.particle_lifetime))", "(0.36 + 0.15 * v.particle_random_3) * (0.6 + 0.35 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)) * (0.6 + 0.9 * (v.particle_age / v.particle_lifetime))"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 16,
          "uv": ["16 * (3 + math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 7))", 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["0.22", "0.2", "0.19", "0.72 * (1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))"]
      }
    }
  }
}
