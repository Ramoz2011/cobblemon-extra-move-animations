{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:muddywater_drips",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/mud/mudbubble"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_update_expression": "v.bl = math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.0);v.fx = math.clamp(0.55 + 0.4 * v.bl, 0.7, 1.8);v.rw = 0.5 * v.entity_width + 0.15;v.mt = v.particle_age;v.tb = 0.05 + 0.85 * v.particle_random_1;v.sn = v.mt - v.tb;v.s = math.max(v.sn, 0);v.an = 360 * v.particle_random_2;v.rd = v.rw * (0.6 + 0.3 * v.particle_random_3);v.y0 = v.entity_height * (0.5 + 0.45 * v.particle_random_3);v.y = v.y0 - 0.4 * v.s - 3.5 * math.pow(math.max(v.s - 0.12, 0), 2);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.25
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.rd * math.cos(v.an)",
          "v.y",
          "v.rd * math.sin(v.an)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.09 + 0.04 * v.particle_random_4) * v.fx * math.clamp((v.sn) / 0.08, 0, 1) * math.clamp((0.65 - (v.sn)) * 30, 0, 1) * math.clamp(v.y * 8, 0, 1)",
          "(0.09 + 0.04 * v.particle_random_4) * v.fx * math.clamp((v.sn) / 0.08, 0, 1) * math.clamp((0.65 - (v.sn)) * 30, 0, 1) * math.clamp(v.y * 8, 0, 1) * 1.3"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 80,
          "texture_height": 8,
          "uv": [
            "8 * (2 + math.floor(v.particle_random_4 * 2))",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          1
        ]
      }
    }
  }
}
