{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:beatup_trail",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/fire/cloudyfire_white"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.25,
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.24 + 0.08 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "0.3 * v.particle_random_2",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.floor(v.particle_random_4 * 4) * 90"
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["(0.3 + 0.08 * v.particle_random_3) * (1 - 0.6 * (v.particle_age / v.particle_lifetime))", "(0.3 + 0.08 * v.particle_random_3) * (1 - 0.6 * (v.particle_age / v.particle_lifetime))"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 16,
          "uv": ["16 * (4 + math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 6))", 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#8C3A1A6A",
            "0.5": "#5A24123F",
            "1.0": "#001C1030"
          }
        }
      }
    }
  }
}
