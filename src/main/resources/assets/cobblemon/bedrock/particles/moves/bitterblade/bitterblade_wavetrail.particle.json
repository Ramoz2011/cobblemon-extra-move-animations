      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 26
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_update_expression": "v.bl = math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.0);v.fs = math.clamp(0.45 + 0.5 * v.bl, 0.7, 1.9);v.te = v.particle_age + 0.075;v.hd = math.sqrt(v.target_deltax * v.target_deltax + v.target_deltaz * v.target_deltaz);v.sx = 0;v.sy = 0.48 * v.entity_height;v.sz = -math.min(0.5 * v.entity_width + 0.75 * v.bl, 0.45 * v.hd);v.ex = -v.target_deltax;v.ey = v.target_deltay;v.ez = -v.target_deltaz;v.fx = v.ex - v.sx;v.fy = v.ey - v.sy;v.fz = v.ez - v.sz;v.fl = math.max(math.sqrt(v.fx * v.fx + v.fy * v.fy + v.fz * v.fz), 0.01);v.fx = v.fx / v.fl;v.fy = v.fy / v.fl;v.fz = v.fz / v.fl;v.fh = math.max(math.sqrt(v.fx * v.fx + v.fz * v.fz), 0.01);v.ax = -0.82 * v.fz / v.fh;v.ay = 0.57;v.az = 0.82 * v.fx / v.fh;v.fxw = math.clamp(0.6 + 0.35 * v.bl, 0.8, 1.5);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.225
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(v.sx + (v.ex - v.sx) * (v.particle_random_1 * 1.0)) + (0.62 * v.fxw * (v.particle_random_2 - 0.5) * 1.4) * v.ax + v.fx * 2.5 * (math.max(v.te - (0.94 + 0.18 * (v.particle_random_1 * 1.0)), 0) + 0.01 * v.particle_age)",
          "(v.sy + (v.ey - v.sy) * (v.particle_random_1 * 1.0)) + (0.62 * v.fxw * (v.particle_random_2 - 0.5) * 1.4) * v.ay + v.fy * 2.5 * (math.max(v.te - (0.94 + 0.18 * (v.particle_random_1 * 1.0)), 0) + 0.01 * v.particle_age)",
          "(v.sz + (v.ez - v.sz) * (v.particle_random_1 * 1.0)) + (0.62 * v.fxw * (v.particle_random_2 - 0.5) * 1.4) * v.az + v.fz * 2.5 * (math.max(v.te - (0.94 + 0.18 * (v.particle_random_1 * 1.0)), 0) + 0.01 * v.particle_age)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.5 + 0.3 * v.particle_random_4) * v.fxw * math.clamp((v.te - (0.94 + 0.18 * (v.particle_random_1 * 1.0))) * 60, 0, 1) * math.clamp(1 - math.max(v.te - (0.94 + 0.18 * (v.particle_random_1 * 1.0)), 0) / 0.14, 0, 1)",
          "0.06 * v.fxw * math.clamp((v.te - (0.94 + 0.18 * (v.particle_random_1 * 1.0))) * 60, 0, 1) * math.clamp(1 - math.max(v.te - (0.94 + 0.18 * (v.particle_random_1 * 1.0)), 0) / 0.14, 0, 1)"
        ],
