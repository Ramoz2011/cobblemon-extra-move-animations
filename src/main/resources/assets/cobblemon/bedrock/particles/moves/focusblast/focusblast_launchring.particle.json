        "per_update_expression": "v.R = math.clamp(0.30 + 0.20 * v.entity_height, 0.42, 0.85);v.hy = math.min(v.entity_height, 3.6) + 0.9 * v.R;v.hz = -(0.25 * v.entity_width + 0.45 * v.R + math.clamp(v.entity_height - 3.6, 0, 1) * (0.3 * v.entity_width + v.R));"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.95
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.27
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "0",
          "v.hy",
          "v.hz"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.R * 3.0 * math.clamp((v.particle_age - 0.95) / 0.02, 0, 1) * math.clamp((1.25 - v.particle_age) / 0.02, 0, 1)",
          "v.R * 3.0 * math.clamp((v.particle_age - 0.95) / 0.02, 0, 1) * math.clamp((1.25 - v.particle_age) / 0.02, 0, 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 240,
          "texture_height": 20,
          "uv": [
            "20 * math.floor(math.clamp((v.particle_age - 0.95) / 0.3, 0, 0.999) * 12)",
            0
          ],
          "uv_size": [
            20,
            20
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.75,
          0.95,
          1,
          "0.95 - 0.5 * math.clamp((v.particle_age - 0.95) / 0.3, 0, 1)"
        ]
      }
    }
  }
}
