{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:hydropump_charge",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/water/splash"
      }
    },
    "curves": {
      "variable.dropsize": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [0.5, 1, 1, 1, 0.6, 0.1]
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 90,
        "max_particles": 300
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.8
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0.3, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.5
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random_integer(0,3)*90"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_random_1*360 + v.particle_age*560) * (1.7 - (v.particle_age/v.particle_lifetime)*1.35)",
          "(v.particle_random_2*1.5 - 0.4) + v.particle_age*0.7",
          "math.sin(v.particle_random_1*360 + v.particle_age*560) * (1.7 - (v.particle_age/v.particle_lifetime)*1.35)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.16 + v.particle_random_3*0.1) * v.dropsize",
          "(0.11 + v.particle_random_3*0.07) * v.dropsize"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 12,
          "texture_height": 2,
          "uv": ["math.round(v.particle_random_4)*3", 0],
          "uv_size": [3, 2]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.6": "#FFBFEDFF",
            "1.0": "#0055C8FF"
          }
        }
      }
    }
  }
}
