{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:muddywater_burstfoam",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/fire/cloudyfire_white"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_update_expression": "v.bl = math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.0);v.fs = math.clamp(0.45 + 0.5 * v.bl, 0.7, 1.9);v.rw = 0.5 * v.entity_width + 0.3;v.ch = math.clamp(1.1 * v.entity_height + 0.35, 1.0, 3.2);v.tt = v.particle_age + 0.195;v.sn = v.tt - 0.58 - 0.06 * v.particle_random_4;v.lf = 0.42 + 0.12 * v.particle_random_4;v.k = math.clamp(v.sn / v.lf, 0, 1);v.an = -90 + (v.particle_random_1 - 0.5) * 300;v.rd = v.rw + 0.2 + 0.7 * v.k;"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.055
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.rd * math.cos(v.an)",
          "v.ch * (0.1 + 0.35 * v.particle_random_2) + 0.3 * v.k",
          "v.rd * math.sin(v.an)"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.floor(v.particle_random_4 * 4) * 90"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.3 + 0.15 * v.particle_random_3) * v.fs * (0.55 + 0.6 * math.sin(180 * math.min(v.k * 1.4, 1))) * math.clamp((v.sn) / 0.03, 0, 1) * math.clamp((v.lf - (v.sn)) * 30, 0, 1)",
          "(0.3 + 0.15 * v.particle_random_3) * v.fs * (0.55 + 0.6 * math.sin(180 * math.min(v.k * 1.4, 1))) * math.clamp((v.sn) / 0.03, 0, 1) * math.clamp((v.lf - (v.sn)) * 30, 0, 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 16,
          "uv": [
            "16 * (2 + math.floor(math.clamp(v.k, 0, 0.999) * 8))",
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.949 + -0.059 * math.clamp((v.k - 0) / 0.5, 0, 1) + -0.102 * math.clamp((v.k - 0.5) / 0.5, 0, 1)",
          "0.91 + -0.086 * math.clamp((v.k - 0) / 0.5, 0, 1) + -0.165 * math.clamp((v.k - 0.5) / 0.5, 0, 1)",
          "0.824 + -0.141 * math.clamp((v.k - 0) / 0.5, 0, 1) + -0.212 * math.clamp((v.k - 0.5) / 0.5, 0, 1)",
          "0.85 * (1 - v.k * v.k)"
        ]
      }
    }
  }
}
