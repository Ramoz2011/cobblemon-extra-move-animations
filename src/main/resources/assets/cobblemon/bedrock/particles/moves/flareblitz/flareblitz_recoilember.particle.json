{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:flareblitz_recoilember",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/sparkle/glowingsparkle_yellow"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.32
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 46.7,
        "max_particles": 14
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.45 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.2 + 0.15 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "2.5 + 2.5 * v.particle_random_2",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3,
        "linear_acceleration": [0, -6, 0]
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["(0.16 + 0.08 * v.particle_random_3) * (1 - 0.4 * (v.particle_age / v.particle_lifetime))", "(0.16 + 0.08 * v.particle_random_3) * (1 - 0.4 * (v.particle_age / v.particle_lifetime))"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "uv": [0, "8 * (math.floor(math.clamp((v.particle_age / v.particle_lifetime) * 4, 0, 3.99)))"],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.5": "#FFFFD040",
            "1.0": "#FFFF7A10"
          }
        }
      }
    }
  }
}
