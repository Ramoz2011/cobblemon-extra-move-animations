{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:beatup_dissolvesparks",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/sparkle/glowingsparkle"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.4,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.3 + 0.15 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "1.2 + 1.0 * v.particle_random_2",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3,
        "linear_acceleration": [0, 2.2, 0]
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.12", "0.12"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "uv": [0, "8 * (math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 4))"],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#FFE8AEFF",
            "0.6": "#FFB06BFF",
            "1.0": "#006A2CA8"
          }
        }
      }
    }
  }
}
