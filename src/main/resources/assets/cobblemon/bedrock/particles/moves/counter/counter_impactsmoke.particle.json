{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:counter_impactsmoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/fire/cloudyfire_white"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 5
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          "-(0.3 * v.entity_width)"
        ],
        "radius": "0.25 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.4 + 0.15 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "(1.2 + 0.8 * v.particle_random_2) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.8,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.floor(v.particle_random_4 * 4) * 90"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.45 + 0.15 * v.particle_random_3) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (0.7 + 0.5 * (v.particle_age / v.particle_lifetime))",
          "(0.45 + 0.15 * v.particle_random_3) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (0.7 + 0.5 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 16,
          "uv": [
            "16 * (2 + math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 8))",
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#B0FFB060",
            "0.5": "#80E07A40",
            "1.0": "#00A0603A"
          }
        }
      }
    }
  }
}
