{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:muddywater_murk",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/smoke/obscuringsmoke"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 22
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_update_expression": "v.bl = math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.0);v.fx = math.clamp(0.55 + 0.4 * v.bl, 0.7, 1.8);v.rw = 0.5 * v.entity_width + 0.15;v.mt = v.particle_age;v.tb = 0.3 * v.particle_random_4;v.sn = math.max(v.mt - v.tb, 0);v.k = math.clamp(v.sn / 1.1, 0, 1);v.an = 360 * v.particle_random_1 + 35 * v.sn;v.rd = (v.rw + 0.1) * (0.75 + 0.5 * v.particle_random_2);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.45
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.rd * math.cos(v.an)",
          "v.entity_height * (0.55 + 0.45 * v.particle_random_3) + 0.12 * v.sn",
          "v.rd * math.sin(v.an)"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "360 * v.particle_random_2",
        "rotation_rate": 20
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.55 + 0.3 * v.particle_random_4) * v.fx * (0.75 + 0.35 * v.k) * math.clamp((v.mt - v.tb) / 0.25, 0, 1)",
          "(0.55 + 0.3 * v.particle_random_4) * v.fx * (0.75 + 0.35 * v.k) * math.clamp((v.mt - v.tb) / 0.25, 0, 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 80,
          "uv": [
            0,
            "16 * (math.floor(v.particle_random_3 * 4))"
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.416 + 0.196 * math.clamp((v.particle_random_2 - 0) / 1.0, 0, 1)",
          "0.314 + 0.204 * math.clamp((v.particle_random_2 - 0) / 1.0, 0, 1)",
          "0.22 + 0.18 * math.clamp((v.particle_random_2 - 0) / 1.0, 0, 1)",
          "0.78 * math.clamp((1 - v.k) * 2.2, 0, 1)"
        ]
      }
    }
  }
}
