{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:counter_steam",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/fire/cloudyfire_white"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 11,
        "max_particles": 5
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.36
      },
      "minecraft:emitter_shape_disc": {
        "offset": [
          0,
          "0.92 * v.entity_height",
          0
        ],
        "radius": "0.3 * v.entity_width + 0.05",
        "plane_normal": "y"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.42 + 0.12 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "2.6 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)",
          0
        ],
        "linear_drag_coefficient": 2.2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.floor(v.particle_random_4 * 4) * 90"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.34 + 0.12 * v.particle_random_3) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (0.75 + 0.5 * (v.particle_age / v.particle_lifetime))",
          "(0.34 + 0.12 * v.particle_random_3) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (0.75 + 0.5 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 16,
          "uv": [
            "16 * (1 + math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 8))",
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "0.85 * (1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))"
        ]
      }
    }
  }
}
