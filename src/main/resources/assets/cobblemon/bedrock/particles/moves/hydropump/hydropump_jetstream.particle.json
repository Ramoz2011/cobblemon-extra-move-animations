{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:hydropump_jetstream",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/water/splash"
      }
    },
    "curves": {
      "variable.watersize": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [0.6, 1, 1, 1, 1, 1, 1, 0.1]
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.target_deltaz=5;v.target_deltax=0;v.target_deltay=0;v.target_distance=3.5;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 80,
        "max_particles": 300
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.4
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, -0.2]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.4
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random_integer(0,3)*90"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(-v.target_deltax * (v.particle_age / v.particle_lifetime))*1.05 + (v.particle_random_1-0.5)*0.5 + math.sin(v.particle_age*720 + v.particle_random_3*360)*0.16",
          "(v.target_deltay * (v.particle_age / v.particle_lifetime))*1.05 + (v.particle_random_2-0.5)*0.5 + math.sin(v.particle_age*540 + v.particle_random_4*360)*0.13",
          "(-v.target_deltaz * (v.particle_age / v.particle_lifetime))*1.05"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.24 + (v.particle_age*0.2) + v.particle_random_3*0.1)*v.watersize",
          "(0.16 + (v.particle_age*0.2) + v.particle_random_3*0.07)*v.watersize"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 12,
          "texture_height": 2,
          "flipbook": {
            "base_UV": ["math.random_integer(0,2)*3", 0],
            "size_UV": [3, 2],
            "step_UV": [3, 0],
            "frames_per_second": 8,
            "max_frame": 4
          }
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.8": "#FFDCF5FF",
            "1.0": "#0078D2FF"
          }
        }
      }
    }
  }
}
