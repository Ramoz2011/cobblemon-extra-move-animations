{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:muddywater_motes",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/orb/mediumfadeorb"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_update_expression": "v.bl = math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.0);v.fx = math.clamp(0.55 + 0.4 * v.bl, 0.7, 1.8);v.rw = 0.5 * v.entity_width + 0.15;v.mt = v.particle_age;v.an = 360 * v.particle_random_1 + (70 + 40 * v.particle_random_4) * v.mt;v.rd = v.rw * 0.9 + 0.2 + 0.2 * v.particle_random_2;v.k = math.clamp(v.mt / 1.45, 0, 1);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.45
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.rd * math.cos(v.an)",
          "v.entity_height * (0.75 + 0.3 * v.particle_random_3) + 0.08 * math.sin(240 * v.mt + 360 * v.particle_random_2)",
          "v.rd * math.sin(v.an)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.05 + 0.03 * v.particle_random_4) * v.fx * math.clamp((v.mt - 0.15 * v.particle_random_3) / 0.2, 0, 1)",
          "(0.05 + 0.03 * v.particle_random_4) * v.fx * math.clamp((v.mt - 0.15 * v.particle_random_3) / 0.2, 0, 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 99,
          "texture_height": 9,
          "uv": [
            45,
            0
          ],
          "uv_size": [
            9,
            9
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.18 + 0.063 * math.clamp((v.particle_random_4 - 0) / 1.0, 0, 1)",
          "0.118 + 0.043 * math.clamp((v.particle_random_4 - 0) / 1.0, 0, 1)",
          "0.063 + 0.016 * math.clamp((v.particle_random_4 - 0) / 1.0, 0, 1)",
          "0.95 * (1 - math.pow(v.k, 3))"
        ]
      }
    }
  }
}
