{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:counter_absorbstreaks",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/smallbeam"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 7
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          "(0.55 * math.min(v.entity_height, 3.2))",
          "-(0.5 * v.entity_width + 0.12)"
        ],
        "radius": 0.08,
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.12 + 0.06 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "(6 + 3 * v.particle_random_2) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.3 + 0.15 * v.particle_random_3) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (1 - (v.particle_age / v.particle_lifetime))",
          "0.04 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 140,
          "texture_height": 91,
          "uv": [
            70,
            42
          ],
          "uv_size": [
            70,
            7
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_random_3",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "1.0": "#FFFFE27A"
          }
        }
      }
    }
  }
}
