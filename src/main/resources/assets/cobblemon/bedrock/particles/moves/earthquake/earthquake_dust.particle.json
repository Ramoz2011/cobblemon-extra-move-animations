{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:earthquake_dust",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/smoke/smoke"
      }
    },
    "curves": {
      "variable.dustgrow": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [0.55, 0.85, 1, 1.1, 1.15]
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "offset": [0, 0.25, 0],
        "plane_normal": "y",
        "radius": "0.9+v.entity_radius",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8,1.3)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0,360)",
        "rotation_rate": "math.random(-40,40)"
      },
      "minecraft:particle_initial_speed": "math.random(1.5,3)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0.6, 0],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.9+(v.particle_random_2*0.5))*v.dustgrow",
          "(0.9+(v.particle_random_2*0.5))*v.dustgrow"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 96,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [16, 16],
            "step_UV": [0, 16],
            "frames_per_second": 6,
            "max_frame": 6,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#C8E0C09A",
            "0.45": "#A8B08D5F",
            "1.0": "#008B7355"
          }
        }
      }
    }
  }
}
