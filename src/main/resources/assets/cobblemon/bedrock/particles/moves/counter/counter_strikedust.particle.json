          "(0.3 + 0.12 * v.particle_random_3) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (0.6 + 0.6 * (v.particle_age / v.particle_lifetime))"
