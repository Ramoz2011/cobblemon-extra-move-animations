{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:counter_absorbring",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/ring/giantring_white"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          "(0.55 * math.min(v.entity_height, 3.2))",
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.16
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(math.max(0.55 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5), 0.4) + 0.08) * (3.2 - 1.6 * (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))",
          "(math.max(0.55 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5), 0.4) + 0.08) * (3.2 - 1.6 * (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 448,
          "texture_height": 64,
          "uv": [
            "64 * (6 - math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 7))",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          0.93,
          0.62,
          "0.85 * math.clamp((v.particle_age / v.particle_lifetime) * 6, 0, 1) * math.clamp((1 - (v.particle_age / v.particle_lifetime)) * 6, 0, 1)"
        ]
      }
    }
  }
}
