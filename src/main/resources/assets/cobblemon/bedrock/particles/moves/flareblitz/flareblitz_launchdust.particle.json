{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:flareblitz_launchdust",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/fire/cloudyfire_white"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_disc": {
        "offset": [0, 0.12, 0],
        "radius": "0.3 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)",
        "plane_normal": "y",
        "surface_only": true,
        "direction": ["(v.particle_random_1 - 0.5) * 2", 0.5, 1.6]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.45 + 0.25 * v.particle_random_2"
      },
      "minecraft:particle_initial_speed": "2.0 + 2.0 * v.particle_random_3",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4,
        "linear_acceleration": [0, 0.8, 0]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.floor(v.particle_random_4 * 4) * 90"
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["(0.35 + 0.2 * v.particle_random_4) * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5) * (0.6 + 0.7 * (v.particle_age / v.particle_lifetime))", "(0.35 + 0.2 * v.particle_random_4) * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5) * (0.6 + 0.7 * (v.particle_age / v.particle_lifetime))"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 16,
          "uv": ["16 * (3 + math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 7))", 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["0.45", "0.41", "0.37", "0.65 * (1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))"]
      }
    }
  }
}
