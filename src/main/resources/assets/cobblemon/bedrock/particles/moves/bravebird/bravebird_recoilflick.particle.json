{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:bravebird_recoilflick",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/smallbeam"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.32
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 40.0,
        "max_particles": 12
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.5 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.10 + 0.08 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "2.5 + 2.0 * v.particle_random_2",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 6
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.32 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5) * (1 - (v.particle_age / v.particle_lifetime))", "0.035 * math.sqrt(math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5))"],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 140,
          "texture_height": 91,
          "uv": [70, 42],
          "uv_size": [70, 7]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["0.8", "0.96", "1", "1 - (v.particle_age / v.particle_lifetime)"]
      }
    }
  }
}
