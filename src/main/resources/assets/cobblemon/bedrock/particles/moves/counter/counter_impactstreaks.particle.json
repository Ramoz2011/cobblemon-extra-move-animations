{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:counter_impactstreaks",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/smallbeam"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          "-(0.3 * v.entity_width)"
        ],
        "radius": "0.15 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.16 + 0.08 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "(11 + 5 * v.particle_random_2) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.7 + 0.4 * v.particle_random_3) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (1 - (v.particle_age / v.particle_lifetime))",
          "0.075 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (1 - 0.5 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 140,
          "texture_height": 91,
          "uv": [
            70,
            42
          ],
          "uv_size": [
            70,
            7
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.4": "#FFFFE27A",
            "0.75": "#FFFF8A2E",
            "1.0": "#FFFF7A6A"
          }
        }
      }
    }
  }
}
