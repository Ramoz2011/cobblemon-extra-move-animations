{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:bravebird_takeoffgust",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/vanilla/gust"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 5
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_disc": {
        "offset": [0, 0.15, 0],
        "radius": "0.35 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)",
        "plane_normal": "y",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.4
      },
      "minecraft:particle_initial_speed": "2.5 + 1.5 * v.particle_random_1",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4,
        "linear_acceleration": [0, 0.6, 0]
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["(0.55 + 0.25 * v.particle_random_2) * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)", "(0.55 + 0.25 * v.particle_random_2) * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 384,
          "texture_height": 32,
          "uv": ["32 * (4 + math.floor((v.particle_age / v.particle_lifetime) * 7.99))", 0],
          "uv_size": [32, 32]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["0.85", "0.96", "1", "0.8 * (1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))"]
      }
    }
  }
}
