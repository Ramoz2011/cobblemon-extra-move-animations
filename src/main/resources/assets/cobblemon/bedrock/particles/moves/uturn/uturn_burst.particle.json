{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:uturn_burst",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/orb/scalingshaded"
      }
    },
    "curves": {
      "variable.size": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [1, 1, 0.9, 0.6, 0]
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "math.clamp(v.entity_width,0.4,2)*0.3",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.2, 0.35)"
      },
      "minecraft:particle_initial_speed": "math.random(3,6)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 6
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.2*v.size", "0.2*v.size"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [0, 16],
            "size_UV": [8, 8],
            "step_UV": [0, -8],
            "frames_per_second": 12,
            "max_frame": 3,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.4": "#FFD3FF8C",
            "1.0": "#FF6EC22E"
          }
        }
      }
    }
  }
}
