{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:hyperbeam_charge",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particles/generic/orb/scaling"
      }
    },
    "curves": {
      "variable.shrinksize": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [0.4, 1, 0.7, 0.15]
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 110,
        "max_particles": 200
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.0
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [0, 0, -0.2],
        "radius": 1.6,
        "surface_only": true,
        "direction": "inwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.3
      },
      "minecraft:particle_initial_speed": 3.0,
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": -5.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18*v.shrinksize",
          "0.18*v.shrinksize"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [8, 8],
            "step_UV": [0, 8],
            "frames_per_second": 20,
            "max_frame": 4,
            "loop": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age*2+(v.emitter_age*0.5)",
          "gradient": {
            "0.0": "#FFFFF2C4",
            "0.25": "#FFFFB43C",
            "0.5": "#FFFFF2C4",
            "0.75": "#FFE0409A",
            "1.0": "#FFFFB43C"
          }
        }
      }
    }
  }
}
