{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:focusblast_impactshards",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/smallbeam"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_radius = 0.6;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.3 * math.clamp(0.55 + 0.45 * v.entity_radius, 0.7, 1.8)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.2 + 0.12 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "11 + 6 * v.particle_random_2",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.7 + 0.5 * v.particle_random_3) * (1 - v.particle_age / v.particle_lifetime)",
          "0.08 * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 140,
          "texture_height": 91,
          "uv": [
            70,
            42
          ],
          "uv_size": [
            70,
            7
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_random_3",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "1.0": "#FFE6FBFF"
          }
        }
      }
    }
  }
}
