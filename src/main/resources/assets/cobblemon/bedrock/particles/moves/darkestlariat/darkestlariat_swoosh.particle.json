{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:darkestlariat_swoosh",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particles/generic/orb/largefadeorb"
      }
    },
    "curves": {
      "variable.fade": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [1, 0.85, 0.55, 0.25, 0]
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "(v.emitter_age >= 0.5 && v.emitter_age < 0.81) ? 440 : ((v.emitter_age >= 0.9 && v.emitter_age < 1.14) ? 220 : 0)",
        "max_particles": 260
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.2
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "math.cos(((v.particle_random_1 < 0.5) ? 0 : 180)-(v.particle_random_2*((v.emitter_age < 0.86) ? 118 : 88)))*(1.4*v.entity_radius)*(0.9+(0.2*v.particle_random_3))",
          "(0.62*v.entity_height)+((v.particle_random_4-0.5)*0.12*v.entity_height)",
          "math.sin(((v.particle_random_1 < 0.5) ? 0 : 180)-(v.particle_random_2*((v.emitter_age < 0.86) ? 118 : 88)))*(1.4*v.entity_radius)*(0.9+(0.2*v.particle_random_3))"
        ],
        "direction": [
          "-math.sin(((v.particle_random_1 < 0.5) ? 0 : 180)-(v.particle_random_2*((v.emitter_age < 0.86) ? 118 : 88)))",
          0,
          "math.cos(((v.particle_random_1 < 0.5) ? 0 : 180)-(v.particle_random_2*((v.emitter_age < 0.86) ? 118 : 88)))"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.15
      },
      "minecraft:particle_initial_speed": 0.6,
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.34+(0.16*v.particle_random_3))*math.clamp(v.entity_radius,0.45,2.2)*v.fade",
          "0.07*math.clamp(v.entity_radius,0.45,2.2)*(0.6+(0.4*v.fade))"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 143,
          "texture_height": 13,
          "uv": [65, 0],
          "uv_size": [13, 13]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "((v.particle_age / v.particle_lifetime)*0.7)+(v.particle_random_2*0.3)",
          "gradient": {
            "0.0": "#FFFFD9D0",
            "0.2": "#FFFF4A52",
            "0.45": "#FFE01E2E",
            "0.75": "#C87A0F1E",
            "1.0": "#00300610"
          }
        }
      }
    }
  }
}
