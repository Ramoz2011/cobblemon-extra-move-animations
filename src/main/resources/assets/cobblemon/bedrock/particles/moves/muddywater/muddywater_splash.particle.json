{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:muddywater_splash",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/orb/mediumfadeorb"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 96
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_update_expression": "v.bl = math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.0);v.fx = math.clamp(0.55 + 0.4 * v.bl, 0.7, 1.8);v.rw = 0.5 * v.entity_width + 0.15;v.an = 360 * v.particle_random_1;v.rd = v.rw * (0.4 + 0.6 * v.particle_random_2);v.vo = 1.0 + 1.8 * v.particle_random_3;v.vu = (4.2 + 2.8 * v.particle_random_4) * math.sqrt(v.fx);v.a = v.particle_age;v.y = 0.1 + v.vu * v.a - 7.5 * v.a * v.a;"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + 0.22 * v.particle_random_2"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(v.rd + v.vo * v.a) * math.cos(v.an)",
          "v.y",
          "(v.rd + v.vo * v.a) * math.sin(v.an) + 1.3 * v.a"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.055 + 0.055 * v.particle_random_3) * v.fx * (1 - 0.35 * (v.particle_age / v.particle_lifetime)) * math.clamp(v.y * 6, 0, 1)",
          "(0.055 + 0.055 * v.particle_random_3) * v.fx * (1 - 0.35 * (v.particle_age / v.particle_lifetime)) * math.clamp(v.y * 6, 0, 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 99,
          "texture_height": 9,
          "uv": [
            45,
            0
          ],
          "uv_size": [
            9,
            9
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.788 + -0.145 * math.clamp(((v.particle_age / v.particle_lifetime) - 0) / 0.5, 0, 1) + -0.224 * math.clamp(((v.particle_age / v.particle_lifetime) - 0.5) / 0.5, 0, 1)",
          "0.659 + -0.173 * math.clamp(((v.particle_age / v.particle_lifetime) - 0) / 0.5, 0, 1) + -0.196 * math.clamp(((v.particle_age / v.particle_lifetime) - 0.5) / 0.5, 0, 1)",
          "0.471 + -0.18 * math.clamp(((v.particle_age / v.particle_lifetime) - 0) / 0.5, 0, 1) + -0.133 * math.clamp(((v.particle_age / v.particle_lifetime) - 0.5) / 0.5, 0, 1)",
          "0.95"
        ]
      }
    }
  }
}
