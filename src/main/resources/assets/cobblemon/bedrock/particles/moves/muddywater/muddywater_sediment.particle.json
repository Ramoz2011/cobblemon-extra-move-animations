{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:muddywater_sediment",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/orb/mediumfadeorb"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 36
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_update_expression": "v.bl = math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.0);v.fs = math.clamp(0.45 + 0.5 * v.bl, 0.7, 1.9);v.rw = 0.5 * v.entity_width + 0.3;v.ch = math.clamp(1.1 * v.entity_height + 0.35, 1.0, 3.2);v.tt = v.particle_age + 0.195;v.rise = math.clamp((v.tt - 0.24) / 0.3, 0, 1);v.on = math.clamp((v.tt - 0.24) * 20, 0, 1) * math.clamp((0.7 - v.tt) * 20, 0, 1);v.an = 360 * v.particle_random_3 + 280 * v.tt;v.rd = v.rw + 0.08 + 0.3 * v.particle_random_1;"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.525
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.rd * math.cos(v.an)",
          "v.ch * v.rise * (0.08 + 0.8 * v.particle_random_2)",
          "v.rd * math.sin(v.an)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.035 + 0.03 * v.particle_random_4) * v.fs * v.on",
          "(0.035 + 0.03 * v.particle_random_4) * v.fs * v.on"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 99,
          "texture_height": 9,
          "uv": [
            45,
            0
          ],
          "uv_size": [
            9,
            9
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.18 + 0.063 * math.clamp((v.particle_random_4 - 0) / 0.7, 0, 1) + 0.4 * math.clamp((v.particle_random_4 - 0.7) / 0.3, 0, 1)",
          "0.118 + 0.043 * math.clamp((v.particle_random_4 - 0) / 0.7, 0, 1) + 0.325 * math.clamp((v.particle_random_4 - 0.7) / 0.3, 0, 1)",
          "0.063 + 0.016 * math.clamp((v.particle_random_4 - 0) / 0.7, 0, 1) + 0.212 * math.clamp((v.particle_random_4 - 0.7) / 0.3, 0, 1)",
          "1"
        ]
      }
    }
  }
}
