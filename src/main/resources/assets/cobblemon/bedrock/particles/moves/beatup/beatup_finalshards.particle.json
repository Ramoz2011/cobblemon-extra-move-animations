{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:beatup_finalshards",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/impact/impact_dark"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, "-(0.35 * v.entity_width + 0.12)"]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.22 + 0.2 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "(9 + 5 * v.particle_random_2) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 6
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_3 * 360"
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.36 * (1 - (v.particle_age / v.particle_lifetime))", "0.36 * (1 - (v.particle_age / v.particle_lifetime))"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 56,
          "uv": [0, "8 * (math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 7))"],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#FF523363",
            "1.0": "#FF1C1030"
          }
        }
      }
    }
  }
}
