        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 48,
          "texture_height": 48,
          "uv": [0, 0],
          "uv_size": [48, 48]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [1, 1, 1, "0.85 * (1 - math.pow((v.particle_age / v.particle_lifetime), 2.5))"]
