{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:beatup_finalstar",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/moves/beatup_star"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_point": {
        "offset": ["0.3 * (v.particle_random_1 - 0.5) * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)", "0.3 * (v.particle_random_2 - 0.5) * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)", "-(0.35 * v.entity_width + 0.12)"]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.32
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_3 * 360"
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["(1.35 + 0.3 * v.particle_random_4) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)", "(1.35 + 0.3 * v.particle_random_4) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 160,
          "uv": [0, "32 * (math.floor(math.clamp(math.pow((v.particle_age / v.particle_lifetime), 0.8), 0, 0.999) * 5))"],
          "uv_size": [32, 32]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [1, 1, 1, 1]
      }
    }
  }
