      "minecraft:particle_appearance_billboard": {
        "size": ["(0.24 + 0.1 * v.particle_random_3) * (0.6 + 0.35 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)) * (0.6 + 0.8 * (v.particle_age / v.particle_lifetime))", "(0.24 + 0.1 * v.particle_random_3) * (0.6 + 0.35 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)) * (0.6 + 0.8 * (v.particle_age / v.particle_lifetime))"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 16,
          "uv": ["16 * (3 + math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 7))", 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["0.26", "0.23", "0.21", "0.7 * (1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))"]
      }
    }
