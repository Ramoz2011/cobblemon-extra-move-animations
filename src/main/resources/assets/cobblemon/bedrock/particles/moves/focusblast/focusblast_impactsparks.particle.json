{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:focusblast_impactsparks",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/orb/glowing_dots_cyan"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_radius = 0.6;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 30
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.25 * math.clamp(0.55 + 0.45 * v.entity_radius, 0.7, 1.8)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.35 + 0.3 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "7 + 5 * v.particle_random_2",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -3,
          0
        ],
        "linear_drag_coefficient": 3.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.12 + 0.08 * v.particle_random_3) * (0.4 + 0.6 * (1 - v.particle_age / v.particle_lifetime))",
          "(0.12 + 0.08 * v.particle_random_3) * (0.4 + 0.6 * (1 - v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_random_3",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.5": "#FF8CEBFF",
            "1.0": "#FF8C8CFF"
          }
        }
      }
    }
  }
}
