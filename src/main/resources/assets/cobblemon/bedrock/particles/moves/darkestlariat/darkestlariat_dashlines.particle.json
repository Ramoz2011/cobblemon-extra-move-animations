{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:darkestlariat_dashlines",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/quickattack_dashlines"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "(v.emitter_age >= 0.03 && v.emitter_age < 0.33) ? 90 : 0",
        "max_particles": 60
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.4
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "math.cos(v.particle_random_1*360)*(0.5+(0.6*v.particle_random_2))*(1.4*v.entity_radius)",
          "(0.15+(0.75*v.particle_random_3))*v.entity_height",
          "math.sin(v.particle_random_1*360)*(0.5+(0.6*v.particle_random_2))*(1.4*v.entity_radius)"
        ],
        "direction": [0, 0, 1]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.14,0.2)"
      },
      "minecraft:particle_initial_speed": "math.random(14,20)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.5+(0.4*v.particle_random_4))*math.clamp(v.entity_radius,0.45,2.2)",
          "0.025*math.clamp(v.entity_radius,0.6,2.2)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 14,
          "texture_height": 1,
          "uv": [4, 0],
          "uv_size": [2, 1]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_random_4",
          "gradient": {
            "0.0": "#E6140609",
            "0.6": "#E62A0A10",
            "1.0": "#E6D81B2C"
          }
        }
      }
    }
  }
}
