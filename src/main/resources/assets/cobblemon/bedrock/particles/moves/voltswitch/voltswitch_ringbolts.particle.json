{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:voltswitch_ringbolts",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particles/generic/electricity/bolt_blue"
      }
    },
    "curves": {
      "variable.fade": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [1, 0.25, 0.9, 0.2, 0.6, 0, 0]
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.target_deltaz=5;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 40,
        "max_particles": 200
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.5
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "-v.target_deltax*(v.emitter_age/0.5)",
          "v.target_deltay*(v.emitter_age/0.5)",
          "-v.target_deltaz*(v.emitter_age/0.5)"
        ],
        "direction": [
          "(v.particle_random_1-0.5)",
          "(v.particle_random_2-0.5)",
          "(v.particle_random_3-0.5)*0.3"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.25
      },
      "minecraft:particle_initial_speed": "math.random(2,4)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.7+(v.particle_random_4*0.5)",
          "(0.15*v.fade)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 114,
          "texture_height": 154,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [114, 13],
            "step_UV": [0, 14],
            "frames_per_second": 30,
            "max_frame": 11,
            "loop": true
          }
        }
      }
    }
  }
}
