{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:counter_powerring",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/ring/giantring_white"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          "(0.55 * math.min(v.entity_height, 3.2))",
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.24
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(math.max(0.55 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5), 0.4) + 0.08) * (1.6 + 2.2 * (1 - math.pow(1 - (v.particle_age / v.particle_lifetime), 2)))",
          "(math.max(0.55 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5), 0.4) + 0.08) * (1.6 + 2.2 * (1 - math.pow(1 - (v.particle_age / v.particle_lifetime), 2)))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 448,
          "texture_height": 64,
          "uv": [
            "64 * (math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 7))",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#FFFFF6D8",
            "0.4": "#FFFFC04A",
            "1.0": "#00FF8A2E"
          }
        }
      }
    }
  }
}
