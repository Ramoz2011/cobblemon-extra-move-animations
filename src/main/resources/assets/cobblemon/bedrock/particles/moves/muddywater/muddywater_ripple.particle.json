{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:muddywater_ripple",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/water/ripple_white"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 7,
        "max_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.42
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0.06,
          0
        ]
      },
      "minecraft:particle_initialization": {
        "per_update_expression": "v.bl = math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.0);v.fx = math.clamp(0.55 + 0.4 * v.bl, 0.7, 1.8);v.rw = 0.5 * v.entity_width + 0.15;"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.6
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(1.0 + 1.6 * (v.particle_age / v.particle_lifetime)) * v.fx",
          "(1.0 + 1.6 * (v.particle_age / v.particle_lifetime)) * v.fx"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 16,
          "texture_height": 144,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              0,
              16
            ],
            "frames_per_second": 20,
            "max_frame": 9,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.89 + -0.247 * math.clamp(((v.particle_age / v.particle_lifetime) - 0) / 1.0, 0, 1)",
          "0.824 + -0.337 * math.clamp(((v.particle_age / v.particle_lifetime) - 0) / 1.0, 0, 1)",
          "0.682 + -0.392 * math.clamp(((v.particle_age / v.particle_lifetime) - 0) / 1.0, 0, 1)",
          "0.9 * (1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))"
        ]
      }
    }
  }
}
