{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:dracometeor_orbtrail",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/sparkle/glowingsparkle"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 90,
        "max_particles": 120
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.38
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          "0.6+(14*v.emitter_age)+(27.5*v.emitter_age*v.emitter_age)",
          0
        ],
        "radius": 0.24
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35,0.5)"
      },
      "minecraft:particle_initial_speed": "math.random(0.3,0.7)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -1.5, 0],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12+(0.1*v.particle_random_4)",
          "0.12+(0.1*v.particle_random_4)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [8, 8],
            "step_UV": [0, 8],
            "frames_per_second": 8,
            "max_frame": 4,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFE0AAFF",
            "0.5": "#FFC77DFF",
            "1.0": "#009D4EDD"
          }
        }
      }
    }
  }
}
