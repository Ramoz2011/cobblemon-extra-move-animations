{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:beatup_burstsparks",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/sparkle/glowingsparkle"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.4 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.22 + 0.1 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "(5 + 3 * v.particle_random_2) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 5
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["(0.13 + 0.05 * v.particle_random_3)", "(0.13 + 0.05 * v.particle_random_3)"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "uv": [0, "8 * (math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 4))"],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#FFE8AEFF",
            "0.5": "#FFB06BFF",
            "1.0": "#FF6A2CA8"
          }
        }
      }
    }
  }
}
