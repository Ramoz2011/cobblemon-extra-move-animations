{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:flareblitz_launchring",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/fire/cloudyfire_white"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_disc": {
        "offset": [0, 0.12, 0],
        "radius": "0.25 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)",
        "plane_normal": "y",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.3 + 0.12 * v.particle_random_2"
      },
      "minecraft:particle_initial_speed": "(5 + 2 * v.particle_random_3) * math.clamp(0.6 + 0.4 * math.max(v.entity_width, v.entity_height), 0.8, 1.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 7,
        "linear_acceleration": [0, 1.5, 0]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.floor(v.particle_random_4 * 4) * 90"
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["(0.36 + 0.14 * v.particle_random_4) * math.clamp(0.6 + 0.4 * math.max(v.entity_width, v.entity_height), 0.8, 1.8) * (1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))", "(0.36 + 0.14 * v.particle_random_4) * math.clamp(0.6 + 0.4 * math.max(v.entity_width, v.entity_height), 0.8, 1.8) * (1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 16,
          "uv": ["16 * (2 + math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 8))", 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "0.15 + 0.85 * (v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.2": "#FFFFE872",
            "0.4": "#FFFFCC00",
            "0.55": "#FFFF9400",
            "0.75": "#FFFF4700",
            "0.9": "#FFFF4700",
            "1.0": "#FF531C0E"
          }
        }
      }
    }
  }
}
