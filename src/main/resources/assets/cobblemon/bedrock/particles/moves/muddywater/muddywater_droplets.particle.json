{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:muddywater_droplets",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/orb/mediumfadeorb"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 40
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          "0.45 * v.entity_height",
          0
        ],
        "radius": "0.3 * v.entity_width",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_initialization": {
        "per_update_expression": "v.bl = math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.0);v.fx = math.clamp(0.55 + 0.4 * v.bl, 0.7, 1.8);v.rw = 0.5 * v.entity_width + 0.15;"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + 0.3 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "(4.0 + 5.0 * v.particle_random_2) * math.sqrt(v.fx)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -16,
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.04,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.045 + 0.04 * v.particle_random_3) * v.fx * (1 - 0.4 * (v.particle_age / v.particle_lifetime))",
          "(0.045 + 0.04 * v.particle_random_3) * v.fx * (1 - 0.4 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 99,
          "texture_height": 9,
          "uv": [
            45,
            0
          ],
          "uv_size": [
            9,
            9
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.42 + 0.224 * math.clamp((v.particle_random_4 - 0) / 0.6, 0, 1) + 0.145 * math.clamp((v.particle_random_4 - 0.6) / 0.4, 0, 1)",
          "0.29 + 0.196 * math.clamp((v.particle_random_4 - 0) / 0.6, 0, 1) + 0.173 * math.clamp((v.particle_random_4 - 0.6) / 0.4, 0, 1)",
          "0.157 + 0.133 * math.clamp((v.particle_random_4 - 0) / 0.6, 0, 1) + 0.18 * math.clamp((v.particle_random_4 - 0.6) / 0.4, 0, 1)",
          "0.95"
        ]
      }
    }
  }
}
