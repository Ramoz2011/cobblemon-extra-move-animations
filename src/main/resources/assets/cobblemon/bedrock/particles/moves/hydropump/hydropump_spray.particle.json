{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:hydropump_spray",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/water/splash"
      }
    },
    "curves": {
      "variable.wpshrink": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [1, 0.86, 0]
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.target_deltaz=5;v.target_deltax=0;v.target_deltay=0;v.target_distance=3.5;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 45,
        "max_particles": 250
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.4
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "math.sin(variable.emitter_age*3280)*3",
          "(1.75-math.cos(variable.emitter_age*2280)*2)+(v.target_deltay/(v.target_distance*0.75))",
          -1
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.55
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random_integer(0,3)*90"
      },
      "minecraft:particle_initial_speed": "math.random(6.25,9.25)*0.65",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -9, 0],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.14+(v.particle_age*0.07))*v.wpshrink",
          "(0.09+(v.particle_age*0.07))*v.wpshrink"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 12,
          "texture_height": 2,
          "uv": ["math.round(v.particle_random_3)*3", 0],
          "uv_size": [3, 2]
        }
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 9,
        "coefficient_of_restitution": 0.6,
        "collision_radius": 0.01
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.74": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}
