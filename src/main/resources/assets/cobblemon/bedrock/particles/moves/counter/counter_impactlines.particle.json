{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:counter_impactlines",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/dashburst"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          "-(0.3 * v.entity_width)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.24
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "3.1 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)",
          "3.1 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 320,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              64,
              64
            ],
            "step_UV": [
              64,
              0
            ],
            "frames_per_second": 20,
            "max_frame": 5,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.35": "#FFFFE27A",
            "0.7": "#FFFF8A2E",
            "1.0": "#FFFF7A6A"
          }
        }
      }
    }
  }
}
