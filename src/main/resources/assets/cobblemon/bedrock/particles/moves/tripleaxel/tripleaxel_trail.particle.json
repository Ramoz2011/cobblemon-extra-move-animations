{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:tripleaxel_trail",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/sparkle/glowingsparkle_cyan"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.target_deltaz=5;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 95,
        "max_particles": 80
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.5
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "(-v.target_deltax*math.clamp(v.emitter_age/0.52,0,1))",
          "(0.3*(1-math.clamp(v.emitter_age/0.52,0,1)))+(v.target_deltay*math.clamp(v.emitter_age/0.52,0,1))",
          "(-0.55*(1-math.clamp(v.emitter_age/0.52,0,1)))+(-v.target_deltaz*math.clamp(v.emitter_age/0.52,0,1))"
        ],
        "direction": [
          "(v.particle_random_1-0.5)*1.4",
          "(v.particle_random_2-0.5)*1.4",
          "(v.particle_random_3-0.5)*1.4"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.18,0.36)"
      },
      "minecraft:particle_initial_speed": "math.random(0.3,1.3)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12+(v.particle_random_4*0.08)",
          "0.12+(v.particle_random_4*0.08)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              0,
              8
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.35": "#CCC8F2FF",
            "1.0": "#009EE4FF"
          }
        }
      }
    }
  }
}
