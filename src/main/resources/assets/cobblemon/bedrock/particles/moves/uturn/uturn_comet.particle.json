{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:uturn_comet",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/orb/scalingshaded"
      }
    },
    "curves": {
      "variable.fade": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [1, 1, 1, 0.95, 0.8, 0.4, 0]
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.target_deltaz=5;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 160,
        "max_particles": 10000
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.12
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "((v.particle_random_1-0.5)*0.3)*v.target_deltaz",
          "(((v.particle_random_2-0.5)*0.35)*v.target_deltaz)+v.target_deltay+(v.target_deltaz*0.45)",
          "-v.target_deltaz/(v.emitter_age*15)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.45,0.65)"
      },
      "minecraft:particle_initial_speed": "((v.particle_random_4+0.5)*7)-v.emitter_age",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -10, 0],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.4-(v.particle_random_3*0.22))*v.fade",
          "(0.4-(v.particle_random_3*0.22))*v.fade"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [0, 16],
            "size_UV": [8, 8],
            "step_UV": [0, -8],
            "frames_per_second": 12,
            "max_frame": 3,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.02,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_random_4",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.35": "#FFD8FF8C",
            "0.7": "#FF9BE84A",
            "1.0": "#FF56B82A"
          }
        }
      }
    }
  }
}
