{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:counter_powerstreaks",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/smallbeam"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 8
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.14 + 0.05 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(0.55 * v.entity_width + 0.2) * math.cos((360 * v.particle_random_1))",
          "v.entity_height * (0.2 + 0.65 * v.particle_random_3) + 0.25 * (0.55 * v.entity_width + 0.2) * math.sin((360 * v.particle_random_1))",
          "0.4 * (0.5 * v.entity_width + 0.12) - ((0.5 * v.entity_width + 0.12) + 1.4 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)) * (1 - math.pow(1 - (v.particle_age / v.particle_lifetime), 2))"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.55 + 0.25 * v.particle_random_3) * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (1 - (v.particle_age / v.particle_lifetime))",
          "0.05 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 140,
          "texture_height": 91,
          "uv": [
            70,
            42
          ],
          "uv_size": [
            70,
            7
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_random_3",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.5": "#FFFFE27A",
            "1.0": "#FFFF8A2E"
          }
        }
      }
    }
  }
}
