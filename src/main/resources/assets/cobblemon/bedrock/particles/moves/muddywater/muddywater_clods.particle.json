{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:muddywater_clods",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/mud/mudsplash"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          "0.3 * v.entity_height",
          "0.2 * v.entity_width"
        ],
        "radius": "0.35 * v.entity_width",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_initialization": {
        "per_update_expression": "v.bl = math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.0);v.fx = math.clamp(0.55 + 0.4 * v.bl, 0.7, 1.8);v.rw = 0.5 * v.entity_width + 0.15;"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.75 + 0.3 * v.particle_random_1"
      },
      "minecraft:particle_initial_speed": "(3.0 + 3.0 * v.particle_random_2) * math.sqrt(v.fx)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -24,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.06,
        "coefficient_of_restitution": 0.45,
        "collision_drag": 4
      },
      "minecraft:particle_initial_spin": {
        "rotation": "360 * v.particle_random_3",
        "rotation_rate": 400
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.07 + 0.05 * v.particle_random_3) * v.fx * (1 - 0.3 * (v.particle_age / v.particle_lifetime))",
          "(0.07 + 0.05 * v.particle_random_3) * v.fx * (1 - 0.3 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 56,
          "uv": [
            0,
            "8 * (math.floor(v.particle_random_4 * 3))"
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "1 - math.pow((v.particle_age / v.particle_lifetime), 4)"
        ]
      }
    }
  }
}
