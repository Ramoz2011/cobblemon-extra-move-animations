{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:focusblast_launchring",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/ring/largering2"
      }
    },
    "components": {
