{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:darkestlariat_fiststar",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particles/generic/sparkle/bigsparkle"
      }
    },
    "curves": {
      "variable.pop": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [
          0.3,
          1.1,
          1,
          0.8,
          0.4
        ]
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.flare = 0; v.side = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.15
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "v.side*(1.4*v.entity_radius)",
          "0.62*v.entity_height",
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
