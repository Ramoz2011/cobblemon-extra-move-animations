{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:beatup_twinkle",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/skyding"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.45 * math.clamp(math.max(v.entity_width, v.entity_height), 0.5, 3.5)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.3
      },
      "minecraft:particle_initial_speed": "3 + 1.5 * v.particle_random_3",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4,
        "linear_acceleration": [0, -4, 0]
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.3 + 0.08 * v.particle_random_4", "0.3 + 0.08 * v.particle_random_4"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 275,
          "texture_height": 25,
          "uv": ["25 * (math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 11))", 0],
          "uv_size": [25, 25]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [0.94, 0.8, 1, 1]
      }
    }
  }
}
