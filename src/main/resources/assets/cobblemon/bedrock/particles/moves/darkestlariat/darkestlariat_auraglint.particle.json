{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:darkestlariat_auraglint",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particles/generic/orb/largefadeorb"
      }
    },
    "curves": {
      "variable.fade": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [0.5, 1, 0.8, 0.4, 0]
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "(v.emitter_age > 0.2 && v.emitter_age < 0.98) ? 48 : 0",
        "max_particles": 80
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "math.cos(v.particle_random_1*360)*(((0.35+(0.3*v.particle_random_2))*v.entity_width)+0.18)",
          "v.particle_random_3*0.9*v.entity_height",
          "math.sin(v.particle_random_1*360)*(((0.35+(0.3*v.particle_random_2))*v.entity_width)+0.18)"
        ],
        "direction": [
          "-math.sin(v.particle_random_1*360)",
          "0.55+(0.5*v.particle_random_4)",
          "math.cos(v.particle_random_1*360)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.22,0.34)"
      },
      "minecraft:particle_initial_speed": "math.random(2.4,3.6)*math.clamp(v.entity_radius,0.6,1.6)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 2.0, 0],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.26+(0.16*v.particle_random_4))*math.clamp(v.entity_radius,0.6,1.8)*v.fade",
          "0.045*math.clamp(v.entity_radius,0.6,1.8)*v.fade"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 143,
          "texture_height": 13,
          "uv": [65, 0],
          "uv_size": [13, 13]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFB3B0",
            "0.25": "#FFE01E2E",
            "0.7": "#C88A0F1C",
            "1.0": "#00500810"
          }
        }
      }
    }
  }
}
