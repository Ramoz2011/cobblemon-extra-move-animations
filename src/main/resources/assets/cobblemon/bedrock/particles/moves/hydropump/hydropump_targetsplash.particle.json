{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:hydropump_targetsplash",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/water/giantsplash"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 10,
        "max_particles": 60
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.1
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [0, 0.4, 0],
        "radius": 0.5,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.5
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(-25,25)"
      },
      "minecraft:particle_initial_speed": "math.random(0.5,1.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 1.5, 0],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.9 + v.particle_random_1*0.9",
          "0.9 + v.particle_random_1*0.9"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 12,
          "texture_height": 96,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [12, 12],
            "step_UV": [0, 12],
            "frames_per_second": 16,
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.7": "#F0E1F7FF",
            "1.0": "#0096E1FF"
          }
        }
      }
    }
  }
}
