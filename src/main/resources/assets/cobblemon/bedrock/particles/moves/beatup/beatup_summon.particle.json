{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:beatup_summon",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/fire/cloudyfire_white"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 9
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_disc": {
        "offset": [0, 0.1, 0],
        "radius": 0.45,
        "plane_normal": "y",
        "surface_only": true,
        "direction": ["(v.particle_random_1 - 0.5) * 0.6", 1, "(v.particle_random_2 - 0.5) * 0.6"]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.35 + 0.15 * v.particle_random_3"
      },
      "minecraft:particle_initial_speed": "1.4 + 0.8 * v.particle_random_4",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.floor(v.particle_random_4 * 4) * 90"
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["(0.24 + 0.1 * v.particle_random_3) * (0.7 + 0.5 * (v.particle_age / v.particle_lifetime))", "(0.24 + 0.1 * v.particle_random_3) * (0.7 + 0.5 * (v.particle_age / v.particle_lifetime))"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 16,
          "uv": ["16 * (3 + math.floor(math.clamp((v.particle_age / v.particle_lifetime), 0, 0.999) * 7))", 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age / v.particle_lifetime)",
          "gradient": {
            "0.0": "#996A2CA8",
            "0.4": "#7A2A1B5E",
            "1.0": "#001C1030"
          }
        }
      }
    }
  }
}
