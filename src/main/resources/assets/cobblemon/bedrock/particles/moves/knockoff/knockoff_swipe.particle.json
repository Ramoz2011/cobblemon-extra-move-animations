{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:knockoff_swipe",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particles/generic/swipe"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 1 },
      "minecraft:emitter_shape_point": {
        "offset": [0, "0.55*q.entity_radius", "-0.25*q.entity_radius"],
        "direction": [1, -0.6, 0.3]
      },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 0.3 },
      "minecraft:particle_initial_spin": { "rotation": 180 },
      "minecraft:particle_initial_speed": 0.1,
      "minecraft:particle_motion_dynamic": { "linear_drag_coefficient": 25 },
      "minecraft:particle_appearance_billboard": {
        "size": [1.3, 0.65],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 32,
          "texture_height": 192,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [32, 32],
            "step_UV": [0, 32],
            "frames_per_second": 18,
            "max_frame": 6
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFB49BD6",
            "0.4": "#FF4A2A6E",
            "1.0": "#00140A1C"
          }
        }
      }
    }
  }
}
