{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:counter_strikeflash",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/moves/bravebird_glow"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.entity_width = 1; v.entity_height = 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          "(0.55 * math.min(v.entity_height, 3.2))",
          "-(0.5 * v.entity_width + 0.12) - 0.15"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.1
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
