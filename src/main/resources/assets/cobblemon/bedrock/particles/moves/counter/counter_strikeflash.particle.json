          "0.8 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (0.7 + 0.6 * (v.particle_age / v.particle_lifetime))",
          "0.8 * math.clamp(0.55 + 0.4 * math.max(v.entity_width, v.entity_height), 0.7, 1.8) * (0.7 + 0.6 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          "0.95 - 0.3 * (v.particle_age / v.particle_lifetime)",
          "0.8 - 0.5 * (v.particle_age / v.particle_lifetime)",
          "1 - (v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}
