{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:hydropump_muzzle",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/water/waterjet_head"
      }
    },
    "curves": {
      "variable.chunkfade": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [0.5, 1, 1, 0.85, 0.5, 0]
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.target_deltaz=5;v.target_deltax=0;v.target_deltay=0;v.target_distance=3.5;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 14,
        "max_particles": 100
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.4
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, -0.3],
        "direction": [
          "-v.target_deltax + math.random(-1.4,1.4)",
          "v.target_deltay + math.random(-0.5,1.5)",
          "-v.target_deltaz"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.35
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0,360)",
        "rotation_rate": "math.random(-240,240)"
      },
      "minecraft:particle_initial_speed": "math.random(2.5,4.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -4, 0],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.45 + v.particle_random_1*0.35)*v.chunkfade",
          "(0.45 + v.particle_random_1*0.35)*v.chunkfade"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [32, 32],
            "step_UV": [0, 32],
            "frames_per_second": 12,
            "max_frame": 4,
            "loop": true
          }
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.7": "#DCE6FAFF",
            "1.0": "#0082C8FF"
          }
        }
      }
    }
